import { ScrollView } from "std-widgets.slint";

component ThemeButton inherits Rectangle {
    in property <string> text;
    in property <color> accent;
    in property <color> foreground;
    in property <color> surface;
    callback clicked;
    height: 30px;
    min-width: button-text.preferred-width + 28px;
    preferred-width: button-text.preferred-width + 28px;
    border-radius: 6px;
    background: touch.pressed ? accent : surface;
    border-width: 1px;
    border-color: accent;
    property <bool> pressed: touch.pressed;
    button-text := Text {
        x: 14px;
        width: parent.width - 28px;
        text: root.text;
        color: root.pressed ? #ffffff : root.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component ThemeToggle inherits Rectangle {
    in property <string> text;
    in property <color> accent;
    in property <color> foreground;
    in property <color> surface;
    in property <color> selected-foreground;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 30px;
    min-width: toggle-text.preferred-width + 28px;
    preferred-width: toggle-text.preferred-width + 28px;
    border-radius: 6px;
    background: checked ? accent : surface;
    border-width: 1px;
    border-color: accent;
    toggle-text := Text {
        x: 14px;
        width: parent.width - 28px;
        text: root.text;
        color: root.checked ? root.selected-foreground : root.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

component ThemeSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <color> accent;
    in property <color> track-color;
    callback changed(float);
    height: 24px;
    min-width: 120px;
    horizontal-stretch: 1;
    Rectangle { y: 10px; height: 4px; width: parent.width; background: root.track-color; border-radius: 2px; }
    Rectangle {
        y: 8px;
        width: 8px;
        height: 8px;
        x: max(0px, min(parent.width - 8px, (root.value - root.minimum) / max(0.0001, root.maximum - root.minimum) * (parent.width - 8px)));
        background: root.accent;
        border-radius: 4px;
    }
    touch := TouchArea {
        moved => { root.changed(root.minimum + max(0px, min(self.mouse-x, parent.width)) / parent.width * (root.maximum - root.minimum)); }
        clicked => { root.changed(root.minimum + max(0px, min(self.mouse-x, parent.width)) / parent.width * (root.maximum - root.minimum)); }
    }
}

export component AppWindow inherits Window {
    title: window-title;
    preferred-width: 720px;
    preferred-height: 650px;
    min-width: 620px;
    min-height: 480px;
    background: window-background;

    in property <string> window-title: "Hyprland CRT Shader Control";
    in property <string> description-text;
    in property <string> language-label;
    in property <string> live-preview-label;
    in property <string> enabled-label;
    in property <string> apply-label;
    in property <string> reset-label;
    in property <string> folder-label;
    in property <string> shortcut-label;
    in property <color> accent-color: #8dc7ff;
    in property <color> window-background: #11151c;
    in property <color> panel-color: #202936;
    in property <color> text-color: #eef4ff;
    in property <color> muted-color: #9daabe;
    in-out property <bool> effect-enabled: true;
    in-out property <bool> live-preview: true;
    in-out property <string> status-text;
    in-out property <int> language-index: 1;
    in property <[string]> languages;
    in property <[string]> group-titles;
    in property <[string]> parameter-labels;
    in property <[float]> parameter-values;
    in property <[float]> parameter-minimums;
    in property <[float]> parameter-maximums;
    in property <[int]> parameter-group-starts;
    in property <[int]> parameter-group-counts;

    callback parameter-changed(int, float);
    callback toggle-effect(bool);
    callback apply-now();
    callback reset-defaults();
    callback open-folder();
    callback emergency-disable();
    callback language-changed(int);

    changed language-index => { root.language-changed(root.language-index); }

    FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: true;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "r" || event.text == "R") { root.reset-defaults(); accept; }
            if event.modifiers.control && event.modifiers.shift && (event.text == "e" || event.text == "E") { root.emergency-disable(); accept; }
            reject;
        }
        VerticalLayout {
            padding: 14px;
            spacing: 6px;
            HorizontalLayout {
                Text { text: root.window-title; color: root.text-color; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.language-label; color: root.muted-color; vertical-alignment: center; }
                ThemeButton { text: root.languages[root.language-index]; accent: root.accent-color; foreground: root.text-color; surface: root.panel-color; width: 96px; clicked => { root.language-changed(Math.mod(root.language-index + 1, 4)); } }
            }
            HorizontalLayout {
                spacing: 10px;
                ThemeToggle { text: root.live-preview-label; accent: root.accent-color; foreground: root.text-color; surface: root.panel-color; selected-foreground: root.window-background; checked <=> root.live-preview; }
                ThemeToggle { text: root.enabled-label; accent: root.accent-color; foreground: root.text-color; surface: root.panel-color; selected-foreground: root.window-background; checked: root.effect-enabled; toggled(value) => { root.effect-enabled = value; root.toggle-effect(value); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { text: root.description-text; color: root.muted-color; font-size: 12px; }
            Text { text: root.shortcut-label; color: root.accent-color; font-size: 11px; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-right: 10px;
                    spacing: 6px;
                    for title[i] in root.group-titles: VerticalLayout {
                        spacing: 2px;
                        Rectangle {
                            height: 25px;
                            background: root.panel-color;
                            border-radius: 5px;
                            Text { x: 10px; width: parent.width - 20px; text: title; color: root.accent-color; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        }
                        for row in root.parameter-group-counts[i]: HorizontalLayout {
                            property <int> parameter-index: root.parameter-group-starts[i] + row;
                            height: 23px;
                            spacing: 12px;
                            Text { text: root.parameter-labels[parent.parameter-index]; color: root.text-color; font-size: 11px; width: 185px; vertical-alignment: center; }
                            ThemeSlider { value: root.parameter-values[parent.parameter-index]; minimum: root.parameter-minimums[parent.parameter-index]; maximum: root.parameter-maximums[parent.parameter-index]; accent: root.accent-color; track-color: root.panel-color; changed(value) => { root.parameter-changed(parent.parameter-index, value); } }
                            Text { text: "" + round(root.parameter-values[parent.parameter-index] * 1000) / 1000; color: root.text-color; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                ThemeButton { text: root.apply-label; accent: root.accent-color; foreground: root.text-color; surface: root.panel-color; clicked => { root.apply-now(); } }
                ThemeButton { text: root.reset-label; accent: root.accent-color; foreground: root.text-color; surface: root.panel-color; clicked => { root.reset-defaults(); } }
                ThemeButton { text: root.folder-label; accent: root.accent-color; foreground: root.text-color; surface: root.panel-color; clicked => { root.open-folder(); } }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.status-text; color: root.accent-color; vertical-alignment: center; }
            }
        }
    }
}
