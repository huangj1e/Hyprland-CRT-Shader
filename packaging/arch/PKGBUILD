# Maintainer: Hyprland CRT Shader contributors
pkgname=hyprland-crt-shader
pkgver=1.1.0
pkgrel=1
pkgdesc='Rust and Slint control panel for the Hyprland CRT screen shader'
arch=('x86_64')
url='https://github.com/huangj1e/Hyprland-CRT-Shader'
license=('MIT')
depends=('hyprland' 'fontconfig' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'cmake' 'ninja')
optdepends=('glslang: validate the GLSL shader locally')
options=('!debug')
source=('project.tar.gz')
sha256sums=('SKIP')

build() {
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --locked --manifest-path "$srcdir/project/Cargo.toml"
}

package() {
    install -Dm644 "$srcdir/project/shaders/crt.frag" \
        "$pkgdir/usr/share/hyprland-crt-shader/crt.frag"
    install -Dm755 "$srcdir/target/release/hyprland-crt-shader" \
        "$pkgdir/usr/bin/hypr-crt-control"
    install -Dm644 "$srcdir/project/packaging/hyprland-crt-control.desktop" \
        "$pkgdir/usr/share/applications/hyprland-crt-control.desktop"
    install -Dm644 "$srcdir/project/config/hyprland-crt-shader.lua" \
        "$pkgdir/usr/share/hyprland-crt-shader/hyprland-crt-shader.lua"
    install -Dm644 "$srcdir/project/config/hyprland-crt-shader.conf" \
        "$pkgdir/usr/share/hyprland-crt-shader/hyprland-crt-shader.conf"
    install -Dm644 "$srcdir/project/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
